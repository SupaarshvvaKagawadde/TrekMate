# Local development defaults. On Render, configure these in the dashboard instead.
NODE_ENV=development
PORT=5000

# Use a local MongoDB instance or replace this with your MongoDB Atlas URI.
# Required in production; local development falls back to this localhost URI.
MONGODB_URI=mongodb://127.0.0.1:27017/trekking_management

# Required. Generate a unique secret, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This placeholder is intentionally rejected when NODE_ENV=production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Local Vite dev server. Optional on Render when Express serves the SPA.
CLIENT_ORIGIN=http://localhost:5173

# Optional rate limiting overrides (defaults: 15 minutes, 600 API, 30 auth, 120 write).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_MAX=120

# Leave blank locally. Production defaults to one trusted proxy hop (Render).
TRUST_PROXY=

# Initial administrator bootstrap. Used only when no admin account exists.
# Replace both values before the first startup.
# ADMIN_PASSWORD must be 12+ characters, not common, and have 6+ unique characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Administrator

# Optional: required only for trek image uploads. Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
